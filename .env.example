# ============================================
# VDiab — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
AI_API_KEY=sk-your-key-here
AI_API_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DB_HOST=localhost
DB_PORT=5533
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=diab
DB_SSLMODE=disable

# ---- Auth / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Admin bootstrap (used by `make seed-admin`) ----
ADMIN_SEED_EMAIL=admin@diab.example.com
ADMIN_SEED_PASSWORD=change-me-strong-password
ADMIN_SEED_NAME=System Admin

# ---- Vector Store ----
# Qdrant server (`make db-up` starts it). QDRANT_LOCATION=:memory: runs an
# in-process store instead (tests only — nothing persists).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ---- Embeddings (local, nothing leaves the machine) ----
# BAAI/bge-m3: multilingual incl. Vietnamese, 1024-dim. Collections are named
# per model (knowledge_base__bge-m3), so changing this needs a re-ingest.
EMBEDDING_MODEL=BAAI/bge-m3
# auto = cuda if available, else cpu
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16
# Where the model is downloaded/cached (~2.3 GB). Unset = ~/.cache/huggingface
# HF_HOME=./data/hf-cache

# ---- App Config ----
APP_ENV=development
APP_PORT=8100
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:5173
REMINDER_TIMEZONE=Asia/Ho_Chi_Minh

# ---- Langfuse (AI tracing — replaces LangSmith) ----
# Self-hosted: `make langfuse-up` -> http://localhost:3300. The stack provisions
# its project with exactly these two keys on first boot, so they work as-is
# locally. Langfuse Cloud: set LANGFUSE_HOST=https://cloud.langfuse.com and
# paste the keys from Project Settings. Leave the keys empty to disable tracing.
# (Backend inside docker-compose reaches it via host.docker.internal — see docker-compose.yml)
LANGFUSE_PUBLIC_KEY=pk-lf-vdiab-local
LANGFUSE_SECRET_KEY=sk-lf-vdiab-local
LANGFUSE_HOST=http://localhost:3300
# Langfuse UI login (first boot only)
LANGFUSE_INIT_USER_EMAIL=admin@vdiab.local
LANGFUSE_INIT_USER_PASSWORD=vdiab-langfuse
# Langfuse server secrets — local-dev defaults live in docker-compose.langfuse.yml;
# override here before exposing the stack anywhere.
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=   # openssl rand -hex 32
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_DB_PASSWORD=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_MINIO_PASSWORD=
# LANGFUSE_REDIS_PASSWORD=

# ---- LangSmith (legacy) ----
# Runtime tracing moved to Langfuse. Only the eval/ harness still uses
# LangSmith datasets/experiments — set these only when running `make eval-*`.
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=vdiab-agent

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Zalo notifications ----
ZALO_NOTIFICATIONS_ENABLED=false
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_API_URL=https://openapi.zalo.me/v3.0/oa/message/cs
ZALO_ZBS_ACCESS_TOKEN=
ZALO_ZBS_API_URL=https://business.openapi.zalo.me/message/template
ZALO_TIMEOUT_SECONDS=10
ZALO_MAX_RETRIES=2

# ---- Zalo Bot Platform notifications (bot-api.zaloplatforms.com) ----
# Separate product from the Zalo OA settings above — no OAuth/PKCE needed,
# just a bot token from https://zalo.me/s/botcreator/. chat_id values are
# learned automatically via the in-app "Connect Zalo" flow (see
# notifications/zalo_link_listener.py) — no manual getUpdates polling needed.
ZALO_BOT_ENABLED=false
ZALO_BOT_TOKEN=
# The bot's own 1:1 chat link (from its info page in the Zalo app — NOT the
# group-invite link, which opens a different flow). Shown as the "Mở Zalo"
# button in the Connect Zalo modal; left blank, the modal falls back to
# asking the patient to search for the bot by name.
ZALO_BOT_CHAT_URL=https://bot.zaloplatforms.com/bots/2218618578028228156
ZALO_LINK_CODE_TTL_MINUTES=10


# ---- Frontend (docker-compose build args; for `npm run dev` use codebase/frontend/.env.local) ----
# NEXT_PUBLIC_API_URL=http://localhost:8100/api/v1
