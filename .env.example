# ============================================
# VDiab — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DB_HOST=localhost
DB_PORT=5533
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=diab
DB_SSLMODE=disable

# ---- Auth / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Admin bootstrap (used by `make seed-admin`) ----
ADMIN_SEED_EMAIL=admin@diab.example.com
ADMIN_SEED_PASSWORD=change-me-strong-password
ADMIN_SEED_NAME=System Admin

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI tracing) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=vdiab-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Zalo notifications ----
ZALO_NOTIFICATIONS_ENABLED=false
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_API_URL=https://openapi.zalo.me/v3.0/oa/message/cs
ZALO_ZBS_ACCESS_TOKEN=
ZALO_ZBS_API_URL=https://business.openapi.zalo.me/message/template
ZALO_TIMEOUT_SECONDS=10
ZALO_MAX_RETRIES=2

# ---- Zalo Bot Platform notifications (bot-api.zaloplatforms.com) ----
# Separate product from the Zalo OA settings above — no OAuth/PKCE needed,
# just a bot token from https://zalo.me/s/botcreator/. chat_id values are
# learned automatically via the in-app "Connect Zalo" flow (see
# notifications/zalo_link_listener.py) — no manual getUpdates polling needed.
ZALO_BOT_ENABLED=false
ZALO_BOT_TOKEN=
# The bot's own 1:1 chat link (from its info page in the Zalo app — NOT the
# group-invite link, which opens a different flow). Shown as the "Mở Zalo"
# button in the Connect Zalo modal; left blank, the modal falls back to
# asking the patient to search for the bot by name.
ZALO_BOT_CHAT_URL=https://bot.zaloplatforms.com/bots/2218618578028228156
ZALO_LINK_CODE_TTL_MINUTES=10


# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
