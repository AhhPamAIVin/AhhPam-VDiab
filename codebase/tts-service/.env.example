# Copy to .env in this directory. This service has its own env — it is not
# read from the repo root .env, keeping it fully independent of
# codebase/backend (same isolation as codebase/stt-service).

HOST=0.0.0.0
PORT=8400

# Shared secret the frontend must send as `Authorization: Bearer <token>`.
# Not patient auth (this service has no access to VDiab's user DB) — just
# keeps the exposed endpoint from being hit by random traffic.
TTS_SERVICE_TOKEN=change-me-to-a-long-random-string

CORS_ORIGINS=["http://localhost:3100"]

# openai | f5_tts_vietnamese_vivoice | vieneu_tts
DEFAULT_TTS_ENGINE=openai

# Reuse the same key already used by codebase/backend's agent and
# codebase/stt-service's correction step — TTS synthesis is a small, cheap
# call, no new provider account needed.
OPENAI_API_KEY=sk-your-key-here
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_INSTRUCTIONS=Nói chậm rãi, ấm áp và rõ ràng, như đang trò chuyện với một người cao tuổi.
TTS_MAX_INPUT_CHARS=4000

# --- Reference voice for f5_tts_vietnamese_vivoice / vieneu_tts (both need
# `pip install -r requirements-f5.txt` / `requirements-vieneu.txt` first).
# Ships with a BOOTSTRAP voice only (see README) — swap before real use.
REF_AUDIO_PATH=./assets/reference_voice.wav
REF_TEXT=hừ thế mày đã nuôi được bố mẹ mày bữa nào chưa hay xưa nay vẫn báo hại cơm cháo mẹ mãi mấy hôm thấy ông đơ mặt không thèm nói mày lại làm già à

# hynt/F5-TTS-Vietnamese-ViVoice is CC-BY-NC-SA-4.0 (non-commercial only).
# F5_DEVICE empty = auto-detect cuda/mps/cpu.
F5_CKPT_REPO=hynt/F5-TTS-Vietnamese-ViVoice
F5_CKPT_FILENAME=model_last.pt
F5_VOCAB_FILENAME=config.json
F5_MODEL_NAME=F5TTS_v1_Base
F5_DEVICE=

# onnx = CPU path (recommended for Apple Silicon local dev); auto = GPU-
# accelerated backend, confirmed working on the GPU box.
VIENEU_BACKEND=onnx
