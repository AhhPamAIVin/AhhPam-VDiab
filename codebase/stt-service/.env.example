# Copy to .env in this directory. This service has its own env — it is not
# read from the repo root .env, keeping it fully independent of codebase/backend.

HOST=0.0.0.0
PORT=8300

# Shared secret the frontend must send as ?token=... on the WS connection.
# Not patient auth (this box has no access to VDiab's user DB) — just keeps
# the exposed GPU endpoint from being hit by random traffic.
STT_SERVICE_TOKEN=change-me-to-a-long-random-string

CORS_ORIGINS=["http://localhost:3000"]

# erax | whisper | qwen_omni — which engine a WS client gets if it omits
# ?engine=. Set this once the 3-way benchmark picks a winner.
DEFAULT_ASR_ENGINE=erax

ERAX_MODEL_ID=erax-ai/EraX-WoW-Turbo-V1.1
WHISPER_MODEL_ID=large-v3-turbo
QWEN_OMNI_MODEL_ID=Qwen/Qwen2.5-Omni-3B

ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
MAX_RESIDENT_ENGINES=1

# Reuse the same key already used by codebase/backend's agent — the
# correction step is a small, cheap call, no new provider account needed.
OPENAI_API_KEY=sk-your-key-here
CORRECTION_MODEL=gpt-4o-mini
