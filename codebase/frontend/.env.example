NEXT_PUBLIC_API_URL=http://localhost:8100/api/v1

# Voice input on the patient AI chat ("speak" button) — points at the
# standalone STT streaming service (codebase/stt-service), which runs on a
# separate GPU box and is NOT the same server as NEXT_PUBLIC_API_URL above.
# It only produces corrected text; the browser still sends that text to
# NEXT_PUBLIC_API_URL's /agent/chat like any typed message. Leave
# NEXT_PUBLIC_STT_WS_URL unset to hide the mic button entirely.
#
# Production: wss://<your-stt-domain>/ws/transcribe behind a TLS reverse
# proxy (see codebase/stt-service/README.md#production-deployment).
# NEXT_PUBLIC_STT_SERVICE_TOKEN must match STT_SERVICE_TOKEN in that box's
# codebase/stt-service/.env — get the value from whoever deployed it.
NEXT_PUBLIC_STT_WS_URL=ws://localhost:8300/ws/transcribe
NEXT_PUBLIC_STT_SERVICE_TOKEN=change-me-to-a-long-random-string

# Auto-read + "listen" button on AI chat replies (both the patient chat and
# the doctor-facing AI tab) — points at the standalone TTS service
# (codebase/tts-service). Distinct from NEXT_PUBLIC_STT_WS_URL above: STT
# turns the patient's voice into text over a streaming WebSocket; this is a
# plain REST call that turns one already-complete assistant reply into
# audio. Leave NEXT_PUBLIC_TTS_API_URL unset to hide the toggle and every
# play button entirely.
NEXT_PUBLIC_TTS_API_URL=http://localhost:8400
NEXT_PUBLIC_TTS_SERVICE_TOKEN=change-me-to-a-long-random-string
